{
  "name": "mapsf-today",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm run tiles:prepare && astro dev --host 0.0.0.0",
    "build": "pnpm run tiles:prepare && astro build && node scripts/tiles/check-assets.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "refresh": "node scripts/refresh-events.mjs",
    "test:browser": "pnpm run build && playwright test",
    "tiles:prepare": "node scripts/tiles/prepare.mjs",
    "tiles:refresh": "node scripts/tiles/refresh.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "maplibre-gl": "6.7.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@playwright/test": "1.63.0",
    "ical.js": "2.2.1",
    "pbf": "5.1.2",
    "pmtiles": "4.3.0",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
