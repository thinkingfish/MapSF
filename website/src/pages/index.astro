---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find something to do in San Francisco. Explore local events, routes, and places on a map, with times, prices, and original sources." />
    <meta name="theme-color" content="#F8F9FA" />
    <title>MapSF — A good day to get out</title>
  </head>
  <body>
    <a class="skip-link" href="#event-results">Skip to events</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="MapSF home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 28 28" fill="none"><path d="m4 7 6-3 8 3 6-3v17l-6 3-8-3-6 3V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 4v17m8-14v17" stroke="currentColor" stroke-width="1.8"/></svg></span>
        <span>Map<span class="brand-sf">SF</span></span>
      </a>
      <span class="header-note"><span class="status-dot" aria-hidden="true"></span> A good day to get out</span>
      <span class="city-label">San Francisco, CA <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.5 6.6C12.5 10 8 14 8 14S3.5 10 3.5 6.6a4.5 4.5 0 0 1 9 0Z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6.5" r="1.5" stroke="currentColor" stroke-width="1.4"/></svg></span>
    </header>
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div><p class="eyebrow">YOUR CITY. YOUR DAY.</p><h1 id="page-title">Out in San Francisco<span>.</span></h1><p class="intro-copy">A few good reasons to take the long way home.</p></div>
        <div class="date-control"><label for="event-date">Make a day of it</label><div class="date-input-row"><input id="event-date" type="date" aria-label="Choose event date" /><button id="today-button" type="button">Today</button></div><span class="timezone-note">San Francisco local time</span></div>
      </section>
      <section class="explore" aria-label="Explore events">
        <div class="toolbar">
          <label class="search-field"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.8" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><input id="event-search" type="search" placeholder="Search events or neighborhoods" aria-label="Search events or neighborhoods" autocomplete="off" /></label>
          <div class="filter-group" aria-label="Filter events by location type"><button class="filter-button active" type="button" data-geometry="all" aria-pressed="true">Everything</button><button class="filter-button" type="button" data-geometry="poi" aria-pressed="false">Places</button><button class="filter-button" type="button" data-geometry="segment" aria-pressed="false">Routes</button><button class="filter-button" type="button" data-geometry="area" aria-pressed="false">Areas</button></div>
          <label class="free-filter"><input id="free-only" type="checkbox" /><span class="checkbox-icon" aria-hidden="true">✓</span>Free only</label>
        </div>
        <div class="mobile-view-controls" aria-label="Jump to view"><button id="show-map" type="button"><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m2 4 4-2 6 2 4-2v12l-4 2-6-2-4 2V4Zm4-2v12m6-10v12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>Map</button><button id="show-list" type="button"><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M6 4h10M6 9h10M6 14h10M2 4h.1M2 9h.1M2 14h.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>List</button></div>
        <div class="explore-grid">
          <section id="map-panel" class="map-panel" aria-label="San Francisco event map" tabindex="-1">
            <div id="map" aria-label="Interactive map of event locations"></div>
            <div class="map-heading"><span class="status-dot" aria-hidden="true"></span> Around the city</div>
            <button id="reset-map" class="reset-map" type="button" aria-label="Show all of San Francisco" title="Show all of San Francisco"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M10 1v4m0 10v4M1 10h4m10 0h4" stroke="currentColor" stroke-width="1.5"/></svg></button>
            <div id="map-status" class="map-status" role="status">Finding our way around…</div>
            <div class="map-legend" aria-label="Map legend"><span><i class="legend-point"></i>Place</span><span><i class="legend-route"></i>Route</span><span><i class="legend-area"></i>Area</span></div>
          </section>
          <section id="event-results" class="results-panel" aria-labelledby="results-title" tabindex="-1">
            <div class="results-heading"><div><p id="day-label" class="eyebrow">EXPLORE TODAY</p><h2 id="results-title">On the radar</h2></div><span id="event-count" class="event-count" aria-live="polite">—</span></div>
            <p id="feed-status" class="feed-status" role="status">Checking the latest local listings…</p>
            <div id="event-list" class="event-list" aria-busy="true"><div class="empty-state"><div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M24 4v5m0 30v5M4 24h5m30 0h5M10 10l4 4m20 20 4 4M10 38l4-4m20-20 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></div><h3>A little city discovery, coming up.</h3><p>Loading events for your day in San Francisco.</p></div></div>
            <noscript><p class="noscript-note">Turn on JavaScript to explore events and the map. You can also <a href="/events.json">read the current event feed</a>.</p></noscript>
            <div class="list-footer"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m8 2 5 2v4c0 3-5 6-5 6S3 11 3 8V4l5-2Z" stroke="currentColor" stroke-width="1.2"/><path d="m5.5 7.5 1.8 1.8 3.5-3.5" stroke="currentColor" stroke-width="1.2"/></svg>Local finds. Original sources. Always check the details.</div>
          </section>
        </div>
      </section>
      <footer class="site-footer"><span>Made for a little more San Francisco.</span><span>Times shown in Pacific time <span aria-hidden="true">↗</span></span></footer>
    </main>
    <script>import '../client/app.mjs';</script>
  </body>
</html>
